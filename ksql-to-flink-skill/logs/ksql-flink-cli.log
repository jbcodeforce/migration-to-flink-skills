This is a ksqlDB `CREATE STREAM` (source table, not CTAS), so it maps to a Flink source-only table with no DML.

```sql
CREATE TABLE IF NOT EXISTS kochnt_precheckin_load_st (
    dateTime STRING,
    data STRUCT<
        precheckin STRUCT<
            driver STRUCT<
                id STRING,
                firstName STRING,
                lastName STRING
            >,
            lastUpdated STRING,
            loads ARRAY<STRUCT<
                product STRUCT<
                    name STRING
                >,
                qty INT,
                releaseNumber STRING,
                scheduled STRUCT<
                    qty INT,
                    uom STRING
                >,
                uom STRING,
                containers ARRAY<STRUCT<
                    trackingInfo STRUCT<
                        id STRING,
                        trailerId STRING,
                        serialNo STRING
                    >
                >>
            >>
        >,
        outbound BOOLEAN,
        status STRING,
        terminal STRUCT<
            name STRING
        >
    >,
    PRIMARY KEY (dateTime) NOT ENFORCED
) DISTRIBUTED BY HASH(dateTime) INTO 1 BUCKETS
WITH (
    'value.format' = 'json-registry',
    'timestamp' = 'dateTime',
    'timestamp.format' = 'yyyy-MM-dd''T''HH:mm:ss.SSS''Z'',
    'partitions' = '6'
);
```

